# Server-side only (Netlify Function). Never use REACT_APP_ for secrets.

# Provider: groq | openai
LLM_PROVIDER=groq

# Groq example: llama-3.1-8b-instant
# OpenAI example: gpt-4o-mini
LLM_MODEL=llama-3.1-8b-instant

# API key from your provider dashboard (do not commit real values)
LLM_API_KEY=your_api_key_here

# Optional request timeout in milliseconds
LLM_TIMEOUT_MS=15000

# Server-side Assistant API catalog (Netlify Functions only). Default: production (6 products).
# staging requires netlify/lib/products.staging.json (npm run sync:catalog:staging).
# Never set staging in production Netlify site environment.
# ASSISTANT_CATALOG_MODE=production
# ASSISTANT_CATALOG_MODE=staging

# Optional local UI staging catalog (do not enable for default production Netlify builds).
# When true at compile time, CRA includes products.generated.json in the bundle.
# Local dev: npm run start:staging  OR  set REACT_APP_USE_STAGING_CATALOG=true then npm start
# Staging UI build (not for production deploy): REACT_APP_USE_STAGING_CATALOG=true npm run build
# REACT_APP_USE_STAGING_CATALOG=true
