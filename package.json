{
  "name": "shopping-cart",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@faker-js/faker": "^7.6.0",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "bootstrap": "^4.6.0",
    "faker": "^6.6.6",
    "react": "^18.2.0",
    "react-bootstrap": "^2.7.2",
    "react-dom": "^18.2.0",
    "react-icons": "^4.7.1",
    "react-router-dom": "^6.8.1",
    "react-scripts": "5.0.1",
    "styled-components": "^6.0.0-rc.2",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "sync:catalog": "node scripts/sync-catalog.js",
    "sync:catalog:staging": "node scripts/sync-catalog-staging.js",
    "prebuild": "npm run sync:catalog",
    "start": "craco start",
    "start:staging": "node scripts/start-staging.js",
    "build": "craco build",
    "build:staging-ui": "cross-env REACT_APP_USE_STAGING_CATALOG=true craco build",
    "test": "craco test",
    "demo:retrieval": "react-scripts test --watchAll=false --testPathPattern=retrieveProducts.test.js",
    "test:retrieval:staging": "react-scripts test --watchAll=false --testPathPattern=retrieveProducts.staging.test.js",
    "test:ask-api": "npm run sync:catalog && node netlify/tests/catalog.test.js && node netlify/tests/prompt.test.js && node netlify/tests/llm.diagnostics.test.js && node netlify/tests/mentionsOnlyRetrievedProducts.test.js && node netlify/tests/ask.handler.test.js",
    "test:ask-api:staging": "npm run sync:catalog:staging && node netlify/tests/ask.handler.staging.test.js",
    "test:assistant": "react-scripts test --watchAll=false --testPathPattern=ShoppingAssistant.test.js",
    "generate:catalog": "node scripts/generate-catalog.js",
    "validate:catalog": "node scripts/validate-catalog.js",
    "validate:staging-quality": "node scripts/validate-staging-quality.js",
    "test:generate-catalog": "node scripts/generate-catalog.test.js",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@craco/craco": "^7.1.0",
    "cross-env": "^10.1.0"
  }
}
